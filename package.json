    "二维码",
    "扫码"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkingyixing/AI-QR-code-scanning-.git"
  },
  "homepage": "https://github.com/mkingyixing/AI-QR-code-scanning-#readme",
